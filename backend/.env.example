# Database URL (SQLite Async)
DATABASE_URL=sqlite+aiosqlite:///./homelibrary.db

# Storage path for covers
COVERS_DIR=./storage/covers

# Server settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Allowed origins for CORS (React Vite frontend & Electron)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
